+
+DEFINE_GUID(IID_IArchiveOpenCallback,
+    0x23170F69, 0x40C1, 0x278A, 0x00, 0x00, 0x00, 0x06, 0x00, 0x10, 0x00, 0x00);
+
+DEFINE_GUID(IID_IArchiveExtractCallback,
